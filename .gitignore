# Dependencies. The plugin is bundled by hand and ships no build step, but the
# profile that links it may still materialise these here.
node_modules/

# OS and editor noise.
.DS_Store
Thumbs.db
*.swp
*~

# Scratch space for local previews and one-off scripts.
.tmp/

# Generated by dev/preview/build.cjs: a bundle, a token dump and a payload captured
# from the local ledger. Rebuild them; never commit them.
dev/preview/app.js
dev/preview/index.html
dev/preview/tokens.css
dev/preview/data.json
